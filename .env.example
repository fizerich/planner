# Meta WhatsApp Cloud API credentials — see SETUP.md for how to obtain these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Only needed if proactive/automated reminders must fire outside a customer-initiated
# 24h window (the normal case for a daily license-expiry check). Create an approved
# utility template in Meta Business Manager with a single {{1}} body parameter, then
# put its name/language here. Leave blank to send plain text instead (works only
# within the 24h window, e.g. while testing in the sandbox).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Where the JSON datastore lives. Leave unset for local dev (uses ./data).
# In production on Railway/Render, point this at your mounted persistent
# volume/disk (e.g. /data) — see DEPLOY.md.
DATA_DIR=

PORT=3000
